%------------------------------------------------------------------------------
%                       Switch to detect LaTeX or PDFTeX
%------------------------------------------------------------------------------
\RequirePackage{ifpdf}
%------------------------------------------------------------------------------
%   Graphics and hyperref.
%
%   The original loaded graphicx and hyperref INSIDE \ifpdf...\else...\fi.
%   Loading a package inside a conditional is a known TeX trap: the package's
%   own \fi tokens are scanned while the outer conditional is still open, and
%   the outer \ifx/\if is left dangling. That is what produced
%       (\end occurred when \ifx on line NNN was incomplete)
%   on every document built with this template since 2005. Harmless until it
%   is not -- a dangling conditional will swallow the next \fi it meets.
%
%   Correct idiom: use the conditional only to SELECT options, then load the
%   packages unconditionally, outside it.
%------------------------------------------------------------------------------
\ifpdf
    \PassOptionsToPackage{pdftex,final}{graphicx}
\else
    \PassOptionsToPackage{final}{graphicx}
    \PassOptionsToPackage{dvipdfm}{hyperref}   % LaTeX -> DVIPDFM
\fi

\RequirePackage{graphicx}
\RequirePackage[colorlinks,linkcolor=black,citecolor=black,urlcolor=black]{hyperref}

% pdfTeX finds .png/.pdf/.jpg by itself; the DVI route needs to be told.
\ifpdf\else
    \DeclareGraphicsExtensions{.eps,.bmp,.jpg,.mps,.png}
\fi

