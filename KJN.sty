% Macros for easy inclusion of figures

\newcommand{\inputfig}[2]
{
\begin{figure}[htbp]
    \begin{center}
        \includegraphics{#1} % it will pull in the figure
        \caption{#2}   % includes fig num
        \label{fig:#1} % ie may \ref{fig:#1}
    \end{center}
\end{figure}
}
\newcommand{\inputfigtop}[2]
{
\begin{figure}[t!]
    \begin{center}
        \includegraphics{#1} % it will pull in the figure
        \caption{#2}   % includes fig num
        \label{fig:#1} % ie may \ref{fig:#1}
    \end{center}
\end{figure}
}
\newcommand{\inputfigbot}[2]
{
\begin{figure}[b!]
    \begin{center}
        \includegraphics{#1} % it will pull in the figure
        \caption{#2}   % includes fig num
        \label{fig:#1} % ie may \ref{fig:#1}
    \end{center}
\end{figure}
}

% This for equation "wheres"
\newcommand{\where}[1]
{
\begin{center}
  \begin{scriptsize}
    \begin{tabular}{clc}
    {#1}
    \end{tabular}
  \end{scriptsize}
\end{center}
}


